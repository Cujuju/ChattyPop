{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"],
      "@main/*": ["./src/main/*"],
      "@plugin-sdk/*": ["./src/plugin-sdk/*"],
      // Upstream `exports` omits "types"; point at the typings the package ships.
      "better-sqlite3-multiple-ciphers": ["./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  },
  "include": ["capacitor.config.ts", "mobile/vite.config.ts", "appVersion.ts", "electron.vite.config.ts", "electron-builder.ts", "vitest.config.ts", "tests/**/*", "src/main/**/*", "src/core/**/*", "src/preload/**/*", "src/shared/**/*", "bundledPlugins.ts", "scripts/**/*.ts", "src/plugin-sdk/shared/**/*", "src/plugin-sdk/core/**/*", "src/plugin-sdk/main/**/*"],
  // Plugin folders for `pnpm plugin:check`, checked by it (tests/pluginCheck.test.ts).
  "exclude": ["tests/fixtures/**"]
}
