{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"],
      "@main/*": ["./src/main/*"],
      "@/*": ["./src/renderer/src/*"],
      "@plugin-sdk/*": ["./src/plugin-sdk/*"],
      "better-sqlite3-multiple-ciphers": ["./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"],
      "@chattypop/host-testing": ["./tests/hostTesting/index.ts"],
      "@chattypop/host-testing/*": ["./tests/*"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"],
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "files": [],
  "include": []
}
