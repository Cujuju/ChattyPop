{
  "name": "chattypop",
  "private": true,
  "description": "Discord archive, AI summaries, topic alerts and media-link feed.",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --win --dir",
    "test": "vitest run",
    "test:ios-cache": "swift test --package-path ios",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --dir",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "plugin:release-changed": "node scripts/runTs.mjs scripts/pluginReleaseChanged.ts",
    "plugin:check": "node scripts/runTs.mjs scripts/pluginCheck.ts",
    "release": "node scripts/runTs.mjs scripts/release.ts",
    "shell:sync": "vite build --config mobile/vite.config.ts && cap sync ios"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@cujuju/electron-updates": "link:../solidjs-toolkit/packages/electron-updates",
    "@cujuju/solid-reorder-list": "github:Cujuju/solid-reorder-list#v0.3.0-rc.4",
    "@cujuju/solidjs-color-picker": "0.3.0",
    "@cujuju/solidjs-hold-action": "0.1.0",
    "@cujuju/solidjs-pill-number-picker": "0.5.1",
    "@cujuju/solidjs-seg-buttons": "0.3.0",
    "@cujuju/solidjs-virtual-log": "0.2.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "emojibase-data": "17.0.0",
    "linkifyjs": "4.4.0",
    "lottie-web": "5.13.0",
    "marked": "18.1.1",
    "mediabunny": "1.62.1",
    "shiki": "3.23.0",
    "simple-icons": "^16.36.0",
    "solid-js": "1.9.17",
    "tar": "7.5.22",
    "temml": "0.13.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/status-bar": "8.0.4",
    "@types/node": "^24.13.6",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint-plugin-solid": "0.18.1",
    "oxc-parser": "0.155.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  }
}
