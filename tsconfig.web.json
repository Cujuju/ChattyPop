{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@/*": ["./src/renderer/src/*"], "@plugin-sdk/*": ["./src/plugin-sdk/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/plugin-sdk/shared/**/*", "src/plugin-sdk/renderer/**/*"]
}
